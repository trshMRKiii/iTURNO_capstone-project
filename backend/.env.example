SECRET_KEY=change-me-generate-a-new-django-secret-key

# Leave unset (or True) for local test runs -> uses db.sqlite3, and the sync
# worker refuses to push to Supabase so test data can't reach the shared
# remote mirror (see backend/settings.py DATABASES comment).
# Set to False on the real terminal -> uses db_production.sqlite3, and the
# sync worker pushes for real.
DEBUG=True

EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-gmail-app-password
DEFAULT_FROM_EMAIL=your-email@gmail.com
# Forgot-password on the Vercel deployment (api/remote/auth/[action].js,
# api/_lib/mailer.js) sends via the SAME Gmail account over SMTP — set these
# same three values in the Vercel project's env vars too, or "Forgot
# password?" on the remote site will silently fail to send.

# Base URL used to build the reset-password and verify-email links sent by
# email. Points at the Vercel deployment (not localhost/LAN) so the emailed
# link opens from anywhere, not just this machine's network.
PUBLIC_APP_URL=https://your-app.vercel.app

# Signs/verifies the password-reset and email-verification links above.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Set the SAME value as EMAIL_LINK_SECRET in the Vercel project's env vars —
# either side (this backend, or api/remote/auth/[action].js on Vercel) needs
# to be able to verify a link the other side issued. Separate from Vercel's
# own REMOTE_JWT_SECRET (login/session tokens), which this backend never
# needs to know.
EMAIL_LINK_SECRET=generate-a-new-random-secret

# Supabase/Postgres — used by the sync engine (api/sync/) plus the request
# paths that read/write User directly (staff registry, login, email
# verification; see UserViewSet.get_queryset). Use the Supavisor TRANSACTION
# pooler (port 6543, USER like postgres.your-project-ref), not the session
# pooler (5432) or direct connection: session mode caps the whole project at
# 15 concurrent clients, which the worker plus every one of those request
# paths blows through fast (see settings.py's DATABASES comment).
DB_NAME=postgres
DB_USER=postgres.your-project-ref
DB_PASSWORD=your-supabase-db-password
DB_HOST=aws-0-your-region.pooler.supabase.com
DB_PORT=6543

# How often `manage.py sync_worker` runs a pull-then-push cycle, and how
# many pending rows it pushes per cycle.
SYNC_INTERVAL_SECONDS=30
SYNC_BATCH_SIZE=200

# SMS queue alerts (PhilSMS — https://philsms.com), sent from dispatch:
# one the moment a vehicle checks into the queue, telling it its current
# queue number (skipped if it lands at #1 — it already knows it's heading
# straight to the loading bay), and one to the vehicle that becomes #1 once
# the current #1 is dispatched ("you're up"). Off by default, same switch
# style as DEBUG above.
# Turn ON: set SMS_ENABLED=True and fill in PHILSMS_API_TOKEN below (from
# your PhilSMS dashboard, under API Tokens).
# Turn OFF: set SMS_ENABLED=False (or delete the line) — api/sms/philsms.py
# then no-ops and just logs instead of calling the PhilSMS API.
SMS_ENABLED=False
PHILSMS_API_TOKEN=your-philsms-api-token
PHILSMS_SENDER_ID=PhilSMS
