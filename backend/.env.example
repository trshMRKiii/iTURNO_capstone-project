SECRET_KEY=change-me-generate-a-new-django-secret-key

# Leave unset (or True) for local test runs -> uses db.sqlite3, and the sync
# worker refuses to push to Supabase so test data can't reach the shared
# remote mirror (see backend/settings.py DATABASES comment).
# Set to False on the real terminal -> uses db_production.sqlite3, and the
# sync worker pushes for real.
DEBUG=True

EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-gmail-app-password
DEFAULT_FROM_EMAIL=your-email@gmail.com

# Supabase/Postgres — always used by the sync engine (api/sync/), regardless
# of DEBUG, to mirror transactions out and pull admin-edited settings down.
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=your-supabase-db-password
DB_HOST=db.your-project-ref.supabase.co
DB_PORT=5432

# How often `manage.py sync_worker` runs a pull-then-push cycle, and how
# many pending rows it pushes per cycle.
SYNC_INTERVAL_SECONDS=30
SYNC_BATCH_SIZE=200

# SMS queue alerts (Semaphore — https://semaphore.co), sent from dispatch:
# one to the vehicle sitting at SMS_QUEUE_ALERT_POSITION in line ("you're
# almost up"), one to the vehicle that becomes #1 once the current #1 is
# dispatched ("you're up"). Off by default, same switch style as DEBUG above.
# Turn ON: set SMS_ENABLED=True and fill in SEMAPHORE_API_KEY below.
# Turn OFF: set SMS_ENABLED=False (or delete the line) — api/sms/semaphore.py
# then no-ops and just logs instead of calling the Semaphore API.
SMS_ENABLED=False
SEMAPHORE_API_KEY=your-semaphore-api-key
SEMAPHORE_SENDER_NAME=
SMS_QUEUE_ALERT_POSITION=5
