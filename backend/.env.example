SECRET_KEY=change-me-generate-a-new-django-secret-key

# Leave unset (or True) for local dev -> uses sqlite3.
# Set to False in production -> uses the Supabase/Postgres settings below.
DEBUG=True

EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-gmail-app-password
DEFAULT_FROM_EMAIL=your-email@gmail.com

DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=your-supabase-db-password
DB_HOST=db.your-project-ref.supabase.co
DB_PORT=5432
